{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Earshot",
  "version": "0.1.0",
  "identifier": "app.earshot.desktop",
  "build": {
    "beforeDevCommand": "npm run build:worker && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:worker -- --release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Earshot",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "media-src": "'self' asset: http://asset.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/earshot-worker"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local meeting recorder and transcriber",
    "copyright": "© 2026 Distraction Digital. MIT License.",
    "publisher": "Distraction Digital",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDOUYzRENFRDdGOThFM0YKUldRL2p2blh6ajJmVERNOENjQzZOcWF5djRMeXhOdU8vbmd4RFJwTE9WbzUzZUE4cU1rMGc1blAK",
      "endpoints": [
        "https://github.com/distractiondigital/earshot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
