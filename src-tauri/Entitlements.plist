<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime: the microphone is blocked unless this is granted. Meeting audio is
       captured with a Core Audio tap, which needs only the NSAudioCaptureUsageDescription
       prompt in Info.plist. No sandbox, no network server, no JIT. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
